# Required
OPENAI_API_KEY=sk-...

# Optional
PORT=3000
OPENAI_MODEL=gpt-transcribe

# Pricing (USD). gpt-transcribe is billed per minute of audio.
PRICE_PER_MINUTE=0.0045

# Optional: set per-1M-token prices to calculate cost from token usage instead
PRICE_AUDIO_INPUT_PER_1M=0
PRICE_TEXT_INPUT_PER_1M=0
PRICE_OUTPUT_PER_1M=0
